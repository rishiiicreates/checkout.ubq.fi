{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "types": ["bun"]
  },
  "include": [
    "bun.ts",
    "main.ts",
    "main_test.ts",
    "src/**/*.ts",
    "demo/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": ["worker.ts", "worker-configuration.d.ts"]
}
